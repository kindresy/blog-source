<%
const topic = engineering_topic(page);
const posts = engineering_reading(topic);
%>
<% if (topic && posts.length) { %>
<widget class="widget-wrapper engineering-related">
  <div class="widget-header"><span class="name"><%= topic.name %> · 阅读顺序</span></div>
  <ol>
    <% for (const post of posts) { %>
      <li><a href="<%= url_for(post.path) %>"<%- post.path === page.path ? ' aria-current="page"' : '' %>><%= post.title %></a></li>
    <% } %>
  </ol>
</widget>
<% } %>
<widget class="widget-wrapper engineering-utilities"><a href="/categories/">所有专题</a><a href="/archives/">归档</a><a href="/tags/">标签</a></widget>
