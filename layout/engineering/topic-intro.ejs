<% const ordered = engineering_reading(topic); %>
<section class="topic-intro">
  <span class="eyebrow">专题阅读 · <%= ordered.length %> 篇</span>
  <h1><%= topic.name %></h1>
  <p><%= topic.description %></p>
  <% if (ordered.length && topic.order.length) { %>
    <details class="reading-route" open>
      <summary>建议从这里开始</summary>
      <ol>
        <% for (const post of ordered.slice(0, topic.readingLimit || ordered.length)) { %>
          <li><a href="<%= url_for(post.path) %>"><%= post.title %></a><span class="route-type"><%= engineering_meta(post).type %></span></li>
        <% } %>
      </ol>
    </details>
  <% } %>
</section>
