<%
page.title = '技术专题与文章分类';
page.layout = 'categories';
page.menu_id = 'post';
const taxonomy = article_taxonomy();
const all = site.categories.toArray();
%>
<%- partial('_partial/main/navbar/nav_tabs_blog') %>
<section class="topic-intro">
  <span class="eyebrow">按问题寻找知识</span>
  <h1>技术专题与文章分类</h1>
  <p>先找一个感兴趣的方向，再沿着原理、实现与工程记录往下读。这里共整理了 <%= site.posts.length %> 篇文章。</p>
</section>
<% for (const [name, children] of Object.entries(taxonomy.categories)) {
  const root = all.find(c => c.name === name && !c.parent); if (!root) continue;
  const branches = Object.keys(children || {}).map(n => all.find(c => c.name === n && c.parent === root._id)).filter(Boolean);
%>
  <section class="category-section" aria-label="<%= name %>">
    <div class="section-heading"><h2><a href="<%= url_for(root.path) %>"><%= name %></a></h2><span><%= root.posts.length %> 篇</span></div>
    <div class="topic-grid">
      <% for (const category of branches) { %><%- partial('engineering/category-card', {category}) %><% } %>
    </div>
  </section>
<% } %>
<section class="category-section article-type-index">
  <div class="section-heading"><h2>也可以按文章类型阅读</h2></div>
  <div class="type-links">
    <% for (const [slug, title] of Object.entries(taxonomy.articleTypes)) { const tag = site.tags.toArray().find(t => t.name === slug); if (!tag) continue; %>
      <a href="<%= url_for(tag.path) %>"><%= title %><span><%= tag.posts.length %></span></a>
    <% } %>
  </div>
</section>
